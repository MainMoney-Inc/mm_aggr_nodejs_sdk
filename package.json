{
  "name": "@mainmoney/sdk",
  "version": "0.1.0",
  "description": "Node.js SDK for the MainMoney aggregator merchant API",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "MainMoney SARL",
  "homepage": "https://github.com/MainMoney-Inc/mm_aggr_nodejs_sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MainMoney-Inc/mm_aggr_nodejs_sdk.git"
  },
  "bugs": {
    "url": "https://github.com/MainMoney-Inc/mm_aggr_nodejs_sdk/issues"
  },
  "keywords": ["mainmoney", "payments", "merchant", "sdk"],
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
